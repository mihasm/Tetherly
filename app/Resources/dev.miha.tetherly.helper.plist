<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Tetherly's root helper, registered by Tetherly.app through SMAppService.
  The program is the named binary Contents/MacOS/tetherly-helper inside the app
  bundle. launchd starts it on demand when a client connects to
  /var/run/tetherly.sock (and once at boot, for auto-connect); it exits by
  itself after 90 s idle when it is not connected and auto-connect is off.
-->
<plist version="1.0">
<dict>
	<key>Label</key><string>dev.miha.tetherly.helper</string>
	<key>BundleProgram</key><string>Contents/MacOS/tetherly-helper</string>
	<key>ProgramArguments</key>
	<array>
		<string>tetherly-helper</string>
		<string>daemon</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array><string>dev.miha.tetherly</string></array>
	<key>RunAtLoad</key><true/>
	<key>Sockets</key>
	<dict>
		<key>Listener</key>
		<dict>
			<key>SockPathName</key><string>/var/run/tetherly.sock</string>
			<key>SockPathMode</key><integer>438</integer>
		</dict>
	</dict>
	<key>StandardErrorPath</key><string>/Library/Logs/tetherly-helper.stderr.log</string>
	<key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
